<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The oneocr command-line tool: fine-tune a recognition model from your own documents (train), measure it (eval) and work through the lines that need a human look (review).</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oneocr</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishAot>true</PublishAot>
    <!-- A NativeAOT build is compiled for one instruction-set level and cannot pick a kernel path at run time: without AVX2 and FMA in the
         target the reader falls back to the exact scalar path, about a hundred times slower. x64 therefore targets AVX2 + FMA (any x86-64 CPU
         since about 2015; an older CPU refuses to start the binary). Pass -p:IlcInstructionSet=x86-64-v4 for AVX-512 machines. Arm needs nothing. -->
    <IlcInstructionSet Condition="'$(IlcInstructionSet)' == '' And $(RuntimeIdentifier.EndsWith('-x64'))">x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOcr.Training/OneOcr.Training.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
