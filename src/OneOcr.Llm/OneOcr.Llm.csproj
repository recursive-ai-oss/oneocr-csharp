  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOcr/OneOcr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Tests" />
