<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PDF bridge for RecursiveAI.OneOcr: text-layer words where a page has them, local OCR for scanned regions, one page model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneOcr/OneOcr.csproj" />
    <!-- OneImage.Pdf 1.10.4 pairs with the OneImage 1.10.4 floor of the core package; OnePdf 1.10.1 carries the inflate fix and satisfies its OnePdf floor. -->
    <PackageReference Include="RecursiveAI.OnePdf" Version="1.10.1" />
    <PackageReference Include="RecursiveAI.OneImage.Pdf" Version="1.10.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Tests" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
    <InternalsVisibleTo Include="$(LibName).AotSmoke" />
  </ItemGroup>

</Project>
