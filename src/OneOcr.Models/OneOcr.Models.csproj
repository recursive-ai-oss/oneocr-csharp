<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Model weights for RecursiveAI.OneOcr. The recognizer is embedded when the package is built with OneOcrModelFile pointing at the pinned file (see models.json).</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="models.json" LogicalName="models.json" />
  </ItemGroup>

  <!--
    Pack step: dotnet pack src/OneOcr.Models -p:OneOcrModelFile=/path/to/model.onm
    The file must hash to the SHA-256 pinned in models.json; the build stops otherwise. Without the property the package builds
    without weights (development builds), and BundledModels reports that none are present. Weights are never checked in.
  -->
  <Target Name="EmbedRecognizer" BeforeTargets="AssignTargetPaths" Condition="'$(OneOcrModelFile)' != ''">
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/models.json'))</_ManifestText>
      <_PinnedSha>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', '"sha256"\s*:\s*"([0-9a-f]{64})"').Groups[1].Value)</_PinnedSha>
      <_PinnedAsset>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', '"asset"\s*:\s*"([^"]+)"').Groups[1].Value)</_PinnedAsset>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneOcrModelFile)')" Text="OneOcrModelFile '$(OneOcrModelFile)' does not exist." />
    <Error Condition="'$(_PinnedSha)' == '' Or '$(_PinnedAsset)' == ''" Text="models.json has no pinned model." />
    <GetFileHash Files="$(OneOcrModelFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_ModelHash" />
    </GetFileHash>
    <PropertyGroup>
      <_ActualSha>%(_ModelHash.FileHash)</_ActualSha>
    </PropertyGroup>
    <Error Condition="'$(_ActualSha.ToLowerInvariant())' != '$(_PinnedSha)'" Text="OneOcrModelFile hashes to $(_ActualSha), but models.json pins $(_PinnedSha). Nothing was packed." />
    <ItemGroup>
      <EmbeddedResource Include="$(OneOcrModelFile)" LogicalName="$(_PinnedAsset)" />
    </ItemGroup>
  </Target>

</Project>
