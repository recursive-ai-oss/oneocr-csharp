<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Model weights for RecursiveAI.OneOcr. The recognizer, the page detector and the word language model are embedded when the package is built with OneOcrModelFile, OneOcrDetectorFile, OneOcrLanguageModelFile and OneOcrWordFrequencyFile pointing at the pinned files (see models.json).</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="models.json" LogicalName="models.json" />
  </ItemGroup>

  <!--
    Pack step: dotnet pack src/OneOcr.Models -p:OneOcrModelFile=/path/to/recognizer.onm -p:OneOcrDetectorFile=/path/to/detector.onm -p:OneOcrLanguageModelFile=/path/to/charlm-v1.bin -p:OneOcrWordFrequencyFile=/path/to/wordfreq-v2.bin
    Each file must hash to the SHA-256 pinned for its role in models.json; the build stops otherwise. Without a property the package
    builds without that model (development builds), and BundledModels reports that it is absent. Weights are never checked in.
  -->
  <Target Name="EmbedRecognizer" BeforeTargets="AssignTargetPaths" Condition="'$(OneOcrModelFile)' != ''">
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/models.json'))</_ManifestText>
      <_PinnedSha>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', '"role"\s*:\s*"recognizer"[^}]*?"sha256"\s*:\s*"([0-9a-f]{64})"').Groups[1].Value)</_PinnedSha>
      <_PinnedAsset>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestText)', '"role"\s*:\s*"recognizer"[^}]*?"asset"\s*:\s*"([^"]+)"').Groups[1].Value)</_PinnedAsset>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneOcrModelFile)')" Text="OneOcrModelFile '$(OneOcrModelFile)' does not exist." />
    <Error Condition="'$(_PinnedSha)' == '' Or '$(_PinnedAsset)' == ''" Text="models.json has no pinned recognizer." />
    <GetFileHash Files="$(OneOcrModelFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_ModelHash" />
    </GetFileHash>
    <PropertyGroup>
      <_ActualSha>%(_ModelHash.FileHash)</_ActualSha>
    </PropertyGroup>
    <Error Condition="'$(_ActualSha.ToLowerInvariant())' != '$(_PinnedSha)'" Text="OneOcrModelFile hashes to $(_ActualSha), but models.json pins $(_PinnedSha) for the recognizer. Nothing was packed." />
    <ItemGroup>
      <EmbeddedResource Include="$(OneOcrModelFile)" LogicalName="$(_PinnedAsset)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedDetector" BeforeTargets="AssignTargetPaths" Condition="'$(OneOcrDetectorFile)' != ''">
    <PropertyGroup>
      <_ManifestTextD>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/models.json'))</_ManifestTextD>
      <_PinnedShaD>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextD)', '"role"\s*:\s*"detector"[^}]*?"sha256"\s*:\s*"([0-9a-f]{64})"').Groups[1].Value)</_PinnedShaD>
      <_PinnedAssetD>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextD)', '"role"\s*:\s*"detector"[^}]*?"asset"\s*:\s*"([^"]+)"').Groups[1].Value)</_PinnedAssetD>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneOcrDetectorFile)')" Text="OneOcrDetectorFile '$(OneOcrDetectorFile)' does not exist." />
    <Error Condition="'$(_PinnedShaD)' == '' Or '$(_PinnedAssetD)' == ''" Text="models.json has no pinned detector." />
    <GetFileHash Files="$(OneOcrDetectorFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_DetectorHash" />
    </GetFileHash>
    <PropertyGroup>
      <_ActualShaD>%(_DetectorHash.FileHash)</_ActualShaD>
    </PropertyGroup>
    <Error Condition="'$(_ActualShaD.ToLowerInvariant())' != '$(_PinnedShaD)'" Text="OneOcrDetectorFile hashes to $(_ActualShaD), but models.json pins $(_PinnedShaD) for the detector. Nothing was packed." />
    <ItemGroup>
      <EmbeddedResource Include="$(OneOcrDetectorFile)" LogicalName="$(_PinnedAssetD)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedLanguageModel" BeforeTargets="AssignTargetPaths" Condition="'$(OneOcrLanguageModelFile)' != ''">
    <PropertyGroup>
      <_ManifestTextL>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/models.json'))</_ManifestTextL>
      <_PinnedShaL>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextL)', '"role"\s*:\s*"language-model"[^}]*?"sha256"\s*:\s*"([0-9a-f]{64})"').Groups[1].Value)</_PinnedShaL>
      <_PinnedAssetL>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextL)', '"role"\s*:\s*"language-model"[^}]*?"asset"\s*:\s*"([^"]+)"').Groups[1].Value)</_PinnedAssetL>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneOcrLanguageModelFile)')" Text="OneOcrLanguageModelFile '$(OneOcrLanguageModelFile)' does not exist." />
    <Error Condition="'$(_PinnedShaL)' == '' Or '$(_PinnedAssetL)' == ''" Text="models.json has no pinned language model." />
    <GetFileHash Files="$(OneOcrLanguageModelFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_LanguageModelHash" />
    </GetFileHash>
    <PropertyGroup>
      <_ActualShaL>%(_LanguageModelHash.FileHash)</_ActualShaL>
    </PropertyGroup>
    <Error Condition="'$(_ActualShaL.ToLowerInvariant())' != '$(_PinnedShaL)'" Text="OneOcrLanguageModelFile hashes to $(_ActualShaL), but models.json pins $(_PinnedShaL) for the language model. Nothing was packed." />
    <ItemGroup>
      <EmbeddedResource Include="$(OneOcrLanguageModelFile)" LogicalName="$(_PinnedAssetL)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedWordFrequencies" BeforeTargets="AssignTargetPaths" Condition="'$(OneOcrWordFrequencyFile)' != ''">
    <PropertyGroup>
      <_ManifestTextW>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/models.json'))</_ManifestTextW>
      <_PinnedShaW>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextW)', '"role"\s*:\s*"word-frequencies"[^}]*?"sha256"\s*:\s*"([0-9a-f]{64})"').Groups[1].Value)</_PinnedShaW>
      <_PinnedAssetW>$([System.Text.RegularExpressions.Regex]::Match('$(_ManifestTextW)', '"role"\s*:\s*"word-frequencies"[^}]*?"asset"\s*:\s*"([^"]+)"').Groups[1].Value)</_PinnedAssetW>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneOcrWordFrequencyFile)')" Text="OneOcrWordFrequencyFile '$(OneOcrWordFrequencyFile)' does not exist." />
    <Error Condition="'$(_PinnedShaW)' == '' Or '$(_PinnedAssetW)' == ''" Text="models.json has no pinned word frequency table." />
    <GetFileHash Files="$(OneOcrWordFrequencyFile)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WordFrequencyHash" />
    </GetFileHash>
    <PropertyGroup>
      <_ActualShaW>%(_WordFrequencyHash.FileHash)</_ActualShaW>
    </PropertyGroup>
    <Error Condition="'$(_ActualShaW.ToLowerInvariant())' != '$(_PinnedShaW)'" Text="OneOcrWordFrequencyFile hashes to $(_ActualShaW), but models.json pins $(_PinnedShaW) for the word frequency table. Nothing was packed." />
    <ItemGroup>
      <EmbeddedResource Include="$(OneOcrWordFrequencyFile)" LogicalName="$(_PinnedAssetW)" />
    </ItemGroup>
  </Target>

</Project>
