<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Renders the page for the live test against a local server. -->
    <PackageReference Include="RecursiveAI.OneImage.Text" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneOcr/OneOcr.csproj" />
    <ProjectReference Include="../../src/OneOcr.Llm/OneOcr.Llm.csproj" />
    <ProjectReference Include="../../src/OneOcr.Training/OneOcr.Training.csproj" />
    <ProjectReference Include="../../src/OneOcr.Pdf/OneOcr.Pdf.csproj" />
    <ProjectReference Include="../../src/OneOcr.Models.Documents/OneOcr.Models.Documents.csproj" />
  </ItemGroup>

</Project>
